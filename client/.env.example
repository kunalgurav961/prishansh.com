# Public SPA configuration from Auth0 Application Settings. Never put a client secret here.
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your_auth0_spa_client_id

# Required only when this SPA calls an Auth0-protected API.
VITE_AUTH0_AUDIENCE=https://api.example.com
VITE_API_BASE_URL=https://api.example.com

# Account API contract. Every endpoint must derive the customer from the validated
# Auth0 bearer token; do not accept a client-provided user id.
# GET/PATCH VITE_ACCOUNT_PROFILE_PATH returns { profile: { name, email, mobile, avatarUrl } }
# GET VITE_ACCOUNT_ORDERS_PATH returns { orders: [] }; POST VITE_ACCOUNT_AVATAR_PATH accepts "avatar".
VITE_ACCOUNT_PROFILE_PATH=/v1/me
VITE_ACCOUNT_ORDERS_PATH=/v1/me/orders
VITE_ACCOUNT_AVATAR_PATH=/v1/me/avatar

# Required only for client-side admin navigation. Use a namespaced Auth0 custom claim.
VITE_AUTH0_ROLES_CLAIM=https://example.com/roles

# Razorpay Public Key ID (optional, frontend also receives key from backend /create-order)
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id
